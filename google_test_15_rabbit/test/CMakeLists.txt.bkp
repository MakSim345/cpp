cmake_minimum_required(VERSION 3.19) # check the version of CMake

set(PROJECT_NAME ExampleTests)
project(${PROJECT_NAME} C CXX)

# GoogleTest requires at least C++14
# set(CMAKE_CXX_STANDARD 14)

set(sources
    exampleTests.cpp
    )

add_executable( ${PROJECT_NAME} ${sources} )

target_link_libraries(${PROJECT_NAME} PUBLIC
    gtest_main
    ci_test_app
    )

add_test(
    NAME ${PROJECT_NAME}
    COMMAND ${PROJECT_NAME}
    )
=====================================
cmake_minimum_required(VERSION 3.10)
project(RabbitRaceTests)

# Enable testing
enable_testing()

# Set C++ standard
set(CMAKE_CXX_STANDARD 17)

# Find Google Test
find_package(GTest REQUIRED)
include_directories(${GTEST_INCLUDE_DIRS})

# Add test source files
add_executable(exampleTests exampleTests.cpp ../random_generator.h ../rabbit.h ../turtle.h ../winner.h)

# Link Google Test and pthread
target_link_libraries(exampleTests ${GTEST_LIBRARIES} pthread)

# Add the test to CTest
add_test(NAME RabbitRaceTests COMMAND exampleTests)

